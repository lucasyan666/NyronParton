# Cloudflare Pages caching. Names that change whenever their content does
# can be kept for a year; everything else (the page itself, sw.js, the
# landing photograph) is revalidated on every visit, so a deploy shows at once.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/photos/drop-*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=604800
